{
  "name": "question-extractor",
  "private": true,
  "version": "0.0.1b",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Chenglittlefat",
  "description": "Question extractor desktop app",
  "scripts": {
    "dev": "concurrently -k \"npm run web:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web:dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "start": "electron .",
    "make": "npm run build && electron-forge make",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.2.1",
    "sql.js": "^1.14.1",
    "vue": "^3.5.34",
    "wait-on": "^9.0.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^42.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "QuestionExtractor",
        "executableName": "question-extractor",
        "asar": {
          "unpack": "**/node_modules/sql.js/dist/sql-wasm.wasm"
        }
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg"
        },
        {
          "name": "@electron-forge/maker-squirrel"
        }
      ]
    }
  }
}
